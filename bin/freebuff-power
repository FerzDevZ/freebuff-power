#!/usr/bin/env bash
# ==============================================================================
# ⚡ FREEBUFF-POWER SUPREME — Omnipotent Multi-Agent & Modular Skills Suite (v6.0)
# ==============================================================================
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

GLOBAL_SUPERPOWER_DIR="$HOME/.freebuff-superpower"
if [ ! -d "$GLOBAL_SUPERPOWER_DIR" ]; then
  mkdir -p "$GLOBAL_SUPERPOWER_DIR"
  if [ -d "$SCRIPT_DIR/../superpower" ]; then
    cp -rf "$SCRIPT_DIR/../superpower/"* "$GLOBAL_SUPERPOWER_DIR/"
  fi
fi

C_CYAN='\033[0;36m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_PURPLE='\033[0;35m'
C_RED='\033[0;31m'
C_BLUE='\033[0;34m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_RESET='\033[0m'

show_help() {
  echo -e "${C_CYAN}${C_BOLD}========================================================================================${C_RESET}"
  echo -e "${C_YELLOW}${C_BOLD}⚡ FREEBUFF-POWER SUPREME — Omnipotent Multi-Agent & Skills Suite (v6.0-Titanium)${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================================${C_RESET}\n"
  echo -e "${C_BOLD}PENGGUNAAN:${C_RESET}"
  echo -e "  ${C_GREEN}freebuff-power${C_RESET} ${C_YELLOW}<command>${C_RESET} [arguments] [options]\n"

  echo -e "${C_PURPLE}${C_BOLD}🔥 PERINTAH UTAMA & PELUNCURAN KODING:${C_RESET}"
  echo -e "  ${C_GREEN}start / go / full${C_RESET}     ${C_BOLD}[REKOMENDASI] One-Shot Launch:${C_RESET}"
  echo -e "                        Reset Telemetry (Anti-Ban) + Injeksi 60 Agents & 1,061 Skills"
  echo -e "                        + Langsung buka sesi interaktif Freebuff siap koding!"
  echo -e "  ${C_GREEN}ui / tui${C_RESET}              Buka Interactive Terminal TUI Dashboard (pilih agen/skill visual)."
  echo -e "  ${C_GREEN}compose <task> [-r]${C_RESET}   ${C_BOLD}[POWER COMPOSER 2.0]${C_RESET} Analisis arsitektur & racik agen/skills terbaik."
  echo -e "  ${C_GREEN}spawn <agent> [task]${C_RESET}  Luncurkan Freebuff dengan persona spesifik (Contoh: spawn architect)."
  echo -e "  ${C_GREEN}init [dir]${C_RESET}            Injeksi AGENTS.md & katalog .freebuff/ ke folder aktif tanpa buka sesi."
  echo -e "  ${C_GREEN}run [args]${C_RESET}            Jalankan sesi Freebuff biasa dengan proteksi Anti-Ban aktif.\n"

  echo -e "${C_PURPLE}${C_BOLD}👥 MULTI-ACCOUNT VAULT & QUOTA ROTATION:${C_RESET}"
  echo -e "  ${C_GREEN}account save <nama>${C_RESET}   Simpan sesi login akun aktif ke dalam vault aman."
  echo -e "  ${C_GREEN}account list${C_RESET}          Lihat daftar akun tersimpan di vault beserta status aktif."
  echo -e "  ${C_GREEN}account switch <nama>${C_RESET} Beralih ke akun lain dalam 0.1 detik (Instant Quota Swap)."
  echo -e "  ${C_GREEN}account rotate${C_RESET}        Putar ke akun berikutnya secara otomatis (Round-Robin Rotator)."
  echo -e "  ${C_GREEN}reset-full / logout${C_RESET}   Reset TOTAL seluruh token login, sesi, dan device fingerprint.\n"

  echo -e "${C_PURPLE}${C_BOLD}🛠️ ENTERPRISE DEVOPS, SECURITY & PRO-TOOLING:${C_RESET}"
  echo -e "  ${C_GREEN}release${C_RESET}               Otomasi Semantic Versioning, update CHANGELOG.md & siapkan tag."
  echo -e "  ${C_GREEN}seed [count] [file]${C_RESET}   Hasilkan ribuan data dummy realistis Indonesia (nama, alamat, IDR)."
  echo -e "  ${C_GREEN}bench [url]${C_RESET}           Uji throughput (RPS), p95 latency & response time API backend."
  echo -e "  ${C_GREEN}theme [name]${C_RESET}          Generate OKLCH modern color palette & token Tailwind CSS v4."
  echo -e "  ${C_GREEN}env${C_RESET}                   Verifikasi kelengkapan variabel .env vs .env.example."
  echo -e "  ${C_GREEN}clean-code${C_RESET}            Pindai file mati (dead-code) & dependensi yang tidak terpakai."
  echo -e "  ${C_GREEN}readme${C_RESET}                Generate README.md standar internasional + diagram Mermaid.js."
  echo -e "  ${C_GREEN}audit / review${C_RESET}        Pindai kebocoran secret API Key, celah OWASP & hapus AI-slop."
  echo -e "  ${C_GREEN}commit${C_RESET}                AI Conventional Commit Assistant otomatis berdasarkan git diff."
  echo -e "  ${C_GREEN}explain <file>${C_RESET}        Bedah arsitektur kode file target & beri rekomendasi swarm persona."
  echo -e "  ${C_GREEN}docker${C_RESET}                Buat Dockerfile multi-stage (< 50MB) & docker-compose.yml siap pakai."
  echo -e "  ${C_GREEN}docs <library>${C_RESET}        Ingest dokumentasi resmi framework terbaru ke dalam konteks AI."
  echo -e "  ${C_GREEN}new <preset> [name]${C_RESET}   Scaffold proyek baru instan (saas / flutter / go) + injeksi 1,055 skills.\n"

  echo -e "${C_PURPLE}${C_BOLD}🌐 LIVE COLLABORATION, PREVIEW & SAFETY:${C_RESET}"
  echo -e "  ${C_GREEN}pair [port]${C_RESET}           Buka Sesi Live Pair-Programming Real-Time (Bagikan link ke tim)."
  echo -e "  ${C_GREEN}share [port]${C_RESET}          Buka HTTPS Public Tunnel & Live Preview ke HP (via Cloudflare)."
  echo -e "  ${C_GREEN}snapshot save <label>${C_RESET} Buat checkpoint snapshot proyek sebelum AI melakukan refactor."
  echo -e "  ${C_GREEN}snapshot list${C_RESET}         Tampilkan seluruh riwayat snapshot checkpoint proyek."
  echo -e "  ${C_GREEN}snapshot restore [id]${C_RESET} Pulihkan seluruh file proyek ke checkpoint snapshot pilihan."
  echo -e "  ${C_GREEN}rollback${C_RESET}              Shortcut instan: Pulihkan proyek ke snapshot terakhir (1 detik)."
  echo -e "  ${C_GREEN}export [--cursor|--claude|--windsurf|--all]${C_RESET}"
  echo -e "                        Ekspor 60 Agents & 1,061 Skills ke semua format AI IDE."
  echo -e "  ${C_GREEN}eval${C_RESET}                  Jalankan Autonomous SWE-Bench Swarm Evaluator (Scorecard A+).\n"

  echo -e "${C_PURPLE}${C_BOLD}💬 MANAJEMEN SESI & CHAT:${C_RESET}"
  echo -e "  ${C_GREEN}continue / resume${C_RESET}     Lanjutkan sesi percakapan/coding terakhir tanpa kehilangan konteks."
  echo -e "  ${C_GREEN}session list${C_RESET}          Tampilkan daftar histori proyek dan riwayat sesi chat.\n"

  echo -e "${C_PURPLE}${C_BOLD}🛡️ ANTI-BAN, UPDATE & PEMELIHARAAN:${C_RESET}"
  echo -e "  ${C_GREEN}clean${C_RESET}                 Reset total anonymous UUID telemetry & lockfile (100% Anti-Ban)."
  echo -e "  ${C_GREEN}doctor${C_RESET}                Pemeriksaan kesehatan sistem (integritas 50 agents & 1,055 skills)."
  echo -e "  ${C_GREEN}update${C_RESET}                Perbarui pustaka Skills & Agents ke versi rilis terbaru dari GitHub.\n"

  echo -e "${C_PURPLE}${C_BOLD}🔍 EKSPLORASI & PANDUAN:${C_RESET}"
  echo -e "  ${C_GREEN}search <keyword>${C_RESET}      Cari Sub-Agent atau Modular Skills berdasarkan kata kunci."
  echo -e "  ${C_GREEN}info <name>${C_RESET}           Buka dan baca SOP / instruksi lengkap dari Agent atau Skill."
  echo -e "  ${C_GREEN}list${C_RESET}                  Tampilkan rekapitulasi 60 Sub-Agents & 1,061 Modular Skills."
  echo -e "  ${C_GREEN}help / --help / -h${C_RESET}    Tampilkan panduan bantuan lengkap ini.\n"

  echo -e "${C_CYAN}----------------------------------------------------------------------------------------${C_RESET}"
  echo -e "${C_BOLD}💡 CONTOH SKENARIO PENGGUNAAN NYATA:${C_RESET}"
  echo -e "  1. Mulai Koding Instan      : ${C_CYAN}$ freebuff-power start${C_RESET}"
  echo -e "  2. Buka Visual Dashboard    : ${C_CYAN}$ freebuff-power ui${C_RESET}"
  echo -e "  3. Live Terminal di Browser : ${C_CYAN}$ freebuff-power pair${C_RESET}"
  echo -e "  4. Buat 20 Data Dummy       : ${C_CYAN}$ freebuff-power seed 20${C_RESET}"
  echo -e "  5. Benchmark API Backend    : ${C_CYAN}$ freebuff-power bench http://localhost:3000${C_RESET}"
  echo -e "  6. Cek Kelengkapan .env     : ${C_CYAN}$ freebuff-power env${C_RESET}"
  echo -e "  7. Bersihkan Kode Mati      : ${C_CYAN}$ freebuff-power clean-code${C_RESET}"
  echo -e "  8. Otomasi Semantic Release : ${C_CYAN}$ freebuff-power release${C_RESET}"
  echo -e "  9. Checkpoint Sebelum AI    : ${C_CYAN}$ freebuff-power snapshot save 'sebelum refactor'${C_RESET}"
  echo -e " 10. Batalkan Kesalahan AI    : ${C_CYAN}$ freebuff-power rollback${C_RESET}"
  echo -e " 11. Putar Akun saat Limit    : ${C_CYAN}$ freebuff-power rotate${C_RESET}"
  echo -e "${C_CYAN}========================================================================================${C_RESET}\n"
}

COMMAND="${1:-}"

case "$COMMAND" in
  ""|help|--help|-h)
    show_help
    ;;

  start|go|full)
    "$SCRIPT_DIR/clean.sh" >/dev/null 2>&1 || true
    "$SCRIPT_DIR/init.sh" . >/dev/null 2>&1 || true
    exec "$SCRIPT_DIR/run.sh"
    ;;

  ui|tui)
    exec node "$SCRIPT_DIR/tui.js"
    ;;

  compose)
    shift || true
    exec node "$SCRIPT_DIR/composer.js" "$@"
    ;;

  spawn)
    shift || true
    exec "$SCRIPT_DIR/spawn.sh" "$@"
    ;;

  init)
    shift || true
    exec "$SCRIPT_DIR/init.sh" "$@"
    ;;

  run)
    shift || true
    exec "$SCRIPT_DIR/run.sh" "$@"
    ;;

  account)
    shift || true
    exec "$SCRIPT_DIR/account.sh" "$@"
    ;;

  rotate)
    exec "$SCRIPT_DIR/account.sh" rotate
    ;;

  reset-full|logout)
    exec "$SCRIPT_DIR/account.sh" reset-full
    ;;

  continue|resume)
    shift || true
    exec node "$SCRIPT_DIR/session.js" continue "$@"
    ;;

  session)
    shift || true
    exec node "$SCRIPT_DIR/session.js" "$@"
    ;;

  release)
    exec "$SCRIPT_DIR/release.sh"
    ;;

  seed)
    shift || true
    exec node "$SCRIPT_DIR/seed.js" "$@"
    ;;

  bench)
    shift || true
    exec node "$SCRIPT_DIR/bench.js" "$@"
    ;;

  theme)
    shift || true
    exec node "$SCRIPT_DIR/theme.js" "$@"
    ;;

  env)
    exec node "$SCRIPT_DIR/envcheck.js"
    ;;

  clean-code)
    exec node "$SCRIPT_DIR/cleancode.js"
    ;;

  readme)
    exec node "$SCRIPT_DIR/readme-gen.js"
    ;;

  hook)
    exec "$SCRIPT_DIR/hook.sh"
    ;;
  ci)
    exec "$SCRIPT_DIR/ci.sh"
    ;;
  pr)
    exec node "$SCRIPT_DIR/pr.js"
    ;;
  explain)
    shift || true
    exec node "$SCRIPT_DIR/explain.js" "$@"
    ;;

  docker|dockerize)
    exec "$SCRIPT_DIR/dockerize.sh"
    ;;

  audit|review)
    shift || true
    exec node "$SCRIPT_DIR/audit.js" "$@"
    ;;

  commit)
    shift || true
    exec "$SCRIPT_DIR/commit.sh" "$@"
    ;;

  docs)
    shift || true
    exec node "$SCRIPT_DIR/docs.js" "$@"
    ;;

  new|scaffold)
    shift || true
    exec "$SCRIPT_DIR/scaffolder.sh" "$@"
    ;;

  pair|collaborate)
    shift || true
    exec "$SCRIPT_DIR/pair.sh" "$@"
    ;;

  share|tunnel)
    shift || true
    exec "$SCRIPT_DIR/share.sh" "$@"
    ;;

  snapshot)
    shift || true
    exec "$SCRIPT_DIR/snapshot.sh" "$@"
    ;;

  rollback)
    exec "$SCRIPT_DIR/snapshot.sh" rollback
    ;;

  export)
    shift || true
    exec node "$SCRIPT_DIR/exporter.js" "$@"
    ;;

  eval)
    exec node "$SCRIPT_DIR/eval.js"
    ;;

  clean)
    exec "$SCRIPT_DIR/clean.sh"
    ;;

  doctor)
    exec "$SCRIPT_DIR/doctor.sh"
    ;;

  update)
    exec "$SCRIPT_DIR/update.sh"
    ;;

  search)
    shift || true
    exec "$SCRIPT_DIR/search.sh" "$@"
    ;;

  info)
    shift || true
    exec "$SCRIPT_DIR/info.sh" "$@"
    ;;

  list)
    exec "$SCRIPT_DIR/list.sh"
    ;;

  *)
    exec "$SCRIPT_DIR/run.sh" "$@"
    ;;
esac
