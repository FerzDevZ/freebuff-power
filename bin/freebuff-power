#!/usr/bin/env bash
# ==============================================================================
# ⚡ FREEBUFF-POWER SUPREME — ULTRA MULTI-AGENT, SKILLS & ANTI-BAN SUITE (v3.8)
# ==============================================================================
# Author: Freebuff Superpower Open-Source Community
# Version: 3.8.0-Enterprise
# License: MIT
# ==============================================================================
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

if [ -d "$REPO_ROOT/superpower/agents" ]; then
  TEMPLATE_DIR="$REPO_ROOT/superpower"
else
  TEMPLATE_DIR="$HOME/.freebuff-superpower"
fi

MANICODE_DIR="$HOME/.config/manicode"
ANALYTICS_FILE="$MANICODE_DIR/analytics-id.json"
OWNER_FILE="$MANICODE_DIR/freebuff-instance-owner.json"
PROJECTS_DIR="$MANICODE_DIR/projects"
REPO_URL="https://github.com/FerzDevZ/freebuff-power.git"

# ANSI Colors
C_CYAN='\033[0;36m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_RED='\033[0;31m'
C_PURPLE='\033[0;35m'
C_BLUE='\033[0;34m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_RESET='\033[0m'

function show_help() {
  cat << 'HELP_EOF'
========================================================================================
⚡ FREEBUFF-POWER SUPREME — Ultra Multi-Agent, Skills & Anti-Ban Suite (v3.8)
========================================================================================

PENGGUNAAN:
  freebuff-power <command> [arguments] [options]

🔥 PERINTAH UTAMA:
  start / go / full     [REKOMENDASI] One-Shot All-in-One:
                        Reset Telemetry (Anti-Ban) + Injeksi 38 Agents & 1,025 Skills
                        + Langsung buka sesi interaktif Freebuff siap koding!

  compose <task> [-r]   [POWER COMPOSER 2.0] Menganalisis kebutuhan arsitektur dan
                        meracik kombinasi Agen & Skills terbaik.
                        Tambahkan flag -r / --run untuk LANGSUNG MELUNCURKAN Freebuff!
                        (Contoh: freebuff-power compose "Bikin web warkop Next.js" --run)

  spawn <agent> [task]  Luncurkan Freebuff dengan persona sub-agent spesifik
                        (Contoh: freebuff-power spawn architect "Rancang API warkop")

  init [dir]            Injeksi file AGENTS.md dan katalog .freebuff/ ke folder aktif

  run [args]            Jalankan sesi Freebuff biasa dengan proteksi Anti-Ban aktif.

💬 MANAJEMEN SESI & CHAT:
  continue / resume     Lanjutkan sesi percakapan/coding terakhir tanpa kehilangan konteks.
  session list          Tampilkan daftar histori proyek dan riwayat sesi chat.

🛡️ ANTI-BAN, UPDATE & PEMELIHARAAN:
  clean                 Reset total anonymous UUID telemetry & lockfile (100% Anti-Ban).
  doctor                Pemeriksaan kesehatan sistem (integritas 1,025 skills, permissions).
  update                Perbarui pustaka Skills & Agents ke versi rilis terbaru dari GitHub.

🔍 EKSPLORASI & PANDUAN:
  search <keyword>      Cari Sub-Agent atau Modular Skills berdasarkan kata kunci.
  info <name>           Buka dan baca SOP / instruksi lengkap dari Agent atau Skill.
  list                  Tampilkan rekapitulasi 38 Sub-Agents & 1,025 Modular Skills.
  help / --help / -h    Tampilkan panduan bantuan ini.

----------------------------------------------------------------------------------------
💡 CONTOH PENGGUNAAN CEPAT:
  $ freebuff-power start                             # Mulai koding instan 1 detik
  $ freebuff-power compose "Bikin web e-commerce" -r # Compose prompt & langsung jalankan
  $ freebuff-power spawn frontend "Buat UI modern"   # Spawn langsung spesifik agen
  $ freebuff-power update                            # Update skill & agent terbaru
========================================================================================
HELP_EOF
}

function apply_anti_ban_shield() {
  mkdir -p "$MANICODE_DIR"
  local new_uuid
  new_uuid="anon_$(cat /proc/sys/kernel/random/uuid 2>/dev/null || python3 -c 'import uuid; print(uuid.uuid4())')"
  echo "{\"anonymousId\": \"$new_uuid\"}" > "$ANALYTICS_FILE"
  
  if [ -f "$OWNER_FILE" ]; then
    rm -f "$OWNER_FILE"
  fi
  
  rm -f "$MANICODE_DIR"/*.lock "$MANICODE_DIR"/*.sock "$MANICODE_DIR"/session-state.json 2>/dev/null || true
  chmod 600 "$ANALYTICS_FILE" 2>/dev/null || true
}

function inject_superpower() {
  local target_dir="${1:-$(pwd)}"
  
  if [ ! -d "$TEMPLATE_DIR" ]; then
    echo -e "${C_RED}❌ Error: Template library $TEMPLATE_DIR tidak ditemukan!${C_RESET}"
    exit 1
  fi

  cp -f "$TEMPLATE_DIR/AGENTS.md" "$target_dir/AGENTS.md"
  mkdir -p "$target_dir/.freebuff/agents" "$target_dir/.freebuff/skills"
  cp -rf "$TEMPLATE_DIR/agents/"* "$target_dir/.freebuff/agents/"
  cp -rf "$TEMPLATE_DIR/skills/"* "$target_dir/.freebuff/skills/"
}

function one_shot_start() {
  local target_dir="$(pwd)"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_YELLOW}${C_BOLD}⚡ [FREEBUFF-POWER] ONE-SHOT ALL-IN-ONE (38 AGENTS & 1,025 SKILLS)...${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  
  apply_anti_ban_shield
  echo -e "${C_GREEN}🛡️  1. Anti-Ban Telemetry Shield : ${C_BOLD}ACTIVE (Fresh Identity)${C_RESET}"
  
  inject_superpower "$target_dir"
  local a_cnt s_cnt
  a_cnt=$(ls -1 "$target_dir/.freebuff/agents" | wc -l)
  s_cnt=$(ls -1 "$target_dir/.freebuff/skills" | wc -l)
  echo -e "${C_GREEN}👥 2. Injeksi Superpower Suite   : ${C_BOLD}$a_cnt Sub-Agents & $s_cnt Skills${C_RESET}"
  echo -e "${C_BLUE}🚀 3. Membuka Sesi Interaktif Freebuff...${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}\n"
  
  export NODE_NO_WARNINGS=1
  exec freebuff "$@"
}

function spawn_agent() {
  local agent="${1:-}"
  shift || true
  local task="$*"
  
  if [ -z "$agent" ]; then
    echo -e "${C_RED}⚠️ Harap sebutkan nama agent! Contoh: freebuff-power spawn architect 'rancang sistem'${C_RESET}"
    echo -e "👉 Jalankan ${C_CYAN}freebuff-power list${C_RESET} untuk melihat daftar agent."
    exit 1
  fi

  agent="${agent#@}"
  local agent_file="$TEMPLATE_DIR/agents/${agent}.md"
  
  if [ ! -f "$agent_file" ]; then
    local matched
    matched=$(find "$TEMPLATE_DIR/agents" -iname "*${agent}*.md" | head -n 1)
    if [ -n "$matched" ]; then
      agent_file="$matched"
      agent=$(basename "$agent_file" .md)
    else
      echo -e "${C_RED}❌ Agent '@$agent' tidak ditemukan.${C_RESET}"
      exit 1
    fi
  fi

  apply_anti_ban_shield
  inject_superpower "$(pwd)"

  echo -e "${C_YELLOW}⚡ [Freebuff-Power] Spawn Sub-Agent: ${C_BOLD}@$agent${C_RESET}"
  if [ -n "$task" ]; then
    echo -e "${C_CYAN}💡 Target Task : $task${C_RESET}"
  fi
  echo -e "${C_GREEN}🚀 Meluncurkan sesi Freebuff...${C_RESET}\n"
  
  export NODE_NO_WARNINGS=1
  exec freebuff
}

# ==============================================================================
# 🧠 POWER COMPOSER 2.0 ENGINE
# ==============================================================================
function compose_prompt() {
  local should_run=0
  local task_args=()
  
  for arg in "$@"; do
    if [[ "$arg" == "-r" || "$arg" == "--run" ]]; then
      should_run=1
    else
      task_args+=("$arg")
    fi
  done

  local query="${task_args[*]:-}"
  if [ -z "$query" ]; then
    echo -e "${C_RED}⚠️ Masukkan deskripsi tugas: freebuff-power compose \"<deskripsi tugas>\" [-r]${C_RESET}"
    exit 1
  fi

  local lower_q
  lower_q="$(echo "$query" | tr '[:upper:]' '[:lower:]')"

  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_YELLOW}${C_BOLD}🧠 [POWER COMPOSER 2.0] Semantic Intent & Swarm Architecture Analyzer${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}\n"
  echo -e "${C_BOLD}Tugas Target:${C_RESET} \"$query\"\n"
  
  local agents=()
  local skills=()
  
  # 1. Frontend & Visual Design
  if [[ "$lower_q" =~ (ui|tampilan|web|frontend|design|desain|css|landing|porto|warkop|html|page|dashboard) ]]; then
    agents+=("@design-engineer" "@frontend")
    skills+=("[Skill: hallmark]" "[Skill: modern-web-design-master]")
    if [[ "$lower_q" =~ (bento|grid|card) ]]; then
      skills+=("[Skill: bento-grid-dashboard-ui]")
    fi
    if [[ "$lower_q" =~ (animasi|motion|framer|interaktif) ]]; then
      skills+=("[Skill: framer-motion-animation-wizard]")
    fi
    if [[ "$lower_q" =~ (3d|three|webgl|game) ]]; then
      agents+=("@game-dev-3d")
      skills+=("[Skill: threejs-webgl-3d-experience]")
    fi
  fi

  # 2. Backend & APIs
  if [[ "$lower_q" =~ (api|backend|rest|grpc|graphql|auth|login|jwt|server|endpoint|crud|oauth) ]]; then
    agents+=("@architect" "@backend")
    skills+=("[Skill: clean-architecture-refactoring]" "[Skill: authflow-security-architect]" "[Skill: api-design-rest-grpc-graphql]")
  fi

  # 3. Database & Big Data
  if [[ "$lower_q" =~ (db|database|sql|postgres|clickhouse|redis|mongo|query|tabel|schema) ]]; then
    agents+=("@database")
    if [[ "$lower_q" =~ (postgres|postgresql|index) ]]; then
      skills+=("[Skill: postgresql-internals-indexing-master]")
    fi
    if [[ "$lower_q" =~ (clickhouse|olap|analytic) ]]; then
      agents+=("@data-engineer-olap")
      skills+=("[Skill: clickhouse-analytics-engineer]")
    fi
  fi

  # 4. Web3 / Smart Contract
  if [[ "$lower_q" =~ (web3|solidity|contract|smart contract|crypto|defi|token|eth|erc) ]]; then
    agents+=("@smart-contract-auditor")
    skills+=("[Skill: smart-contract-web3-security]" "[Skill: solidity-foundry-gas-optimizer]")
  fi

  # 5. AI / RAG / Machine Learning
  if [[ "$lower_q" =~ (ai|rag|llm|vector|embedding|qdrant|ollama|vllm|gpt|claude|chat) ]]; then
    agents+=("@ai-engineer" "@nlp-rag-specialist")
    skills+=("[Skill: rag-llm-integrator]" "[Skill: vector-db-pgvector-qdrant-master]" "[Skill: prompt-injection-defense-guardrails]")
  fi

  # 6. Mobile & Cross-platform
  if [[ "$lower_q" =~ (mobile|android|ios|flutter|react native|swiftui|app) ]]; then
    agents+=("@mobile-engineer")
    skills+=("[Skill: crossplatform-mobile-flutter-rn]")
  fi

  # 7. Testing & Quality Assurance
  if [[ "$lower_q" =~ (test|testing|qa|vitest|unit|e2e|playwright) ]]; then
    agents+=("@tddmaster" "@qa")
    skills+=("[Skill: unit-integration-tdd-master]" "[Skill: e2e-playwright-automation]")
  fi

  # Fallback Defaults
  if [ ${#agents[@]} -eq 0 ]; then
    agents+=("@architect" "@programmer")
    skills+=("[Skill: hallmark]" "[Skill: clean-architecture-refactoring]")
  fi

  # Deduplicate arrays
  local -A seen_agents seen_skills
  local unique_agents=()
  for a in "${agents[@]}"; do
    if [[ -z "${seen_agents[$a]:-}" ]]; then
      seen_agents[$a]=1
      unique_agents+=("$a")
    fi
  done

  local unique_skills=()
  for s in "${skills[@]}"; do
    if [[ -z "${seen_skills[$s]:-}" ]]; then
      seen_skills[$s]=1
      unique_skills+=("$s")
    fi
  done

  echo -e "${C_GREEN}${C_BOLD}👥 Recommended Sub-Agents:${C_RESET} ${unique_agents[*]}"
  echo -e "${C_PURPLE}${C_BOLD}🧰 Recommended Skills    :${C_RESET} ${unique_skills[*]}"
  
  local generated_prompt="Sebagai ${unique_agents[*]}, tolong kerjakan tugas berikut secara menyeluruh: '${query}'. Terapkan ${unique_skills[*]} dengan standar Hallmark craftsmanship, zero AI-slop, dan sertakan unit tests."

  echo -e "\n${C_YELLOW}${C_BOLD}📋 Master Prompt (Siap Eksekusi):${C_RESET}"
  echo -e "${C_CYAN}------------------------------------------------------------------------${C_RESET}"
  echo -e "${C_BOLD}$generated_prompt${C_RESET}"
  echo -e "${C_CYAN}------------------------------------------------------------------------${C_RESET}\n"

  if [ "$should_run" -eq 1 ]; then
    echo -e "${C_GREEN}🚀 Auto-Run Flag Terdeteksi (-r)! Meluncurkan Freebuff sekarang...${C_RESET}\n"
    apply_anti_ban_shield
    inject_superpower "$(pwd)"
    export NODE_NO_WARNINGS=1
    exec freebuff
  else
    echo -e "${C_DIM}👉 Tips: Jalankan 'freebuff-power compose \"$query\" --run' untuk langsung eksekusi!${C_RESET}\n"
  fi
}

function update_library() {
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_YELLOW}${C_BOLD}🔄 [FREEBUFF-POWER] Memperbarui Pustaka Skills & Agents dari GitHub...${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}\n"
  
  curl -fsSL https://raw.githubusercontent.com/FerzDevZ/freebuff-power/main/install.sh | bash
}

function manage_sessions() {
  local subcmd="${1:-list}"
  shift || true

  case "$subcmd" in
    list)
      echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
      echo -e "${C_YELLOW}${C_BOLD}📋 [FREEBUFF-POWER] DAFTAR SESI & RIWAYAT CHAT PROYEK${C_RESET}"
      echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}\n"
      
      if [ -d "$PROJECTS_DIR" ]; then
        echo -e "${C_GREEN}${C_BOLD}📁 Proyek yang Tersedia:${C_RESET}"
        for p in "$PROJECTS_DIR"/*; do
          if [ -d "$p" ]; then
            local pname
            pname="$(basename "$p")"
            local chat_count
            chat_count=$(find "$p/chats" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l || echo "0")
            echo -e "  - ${C_BOLD}$pname${C_RESET} ${C_DIM}($chat_count riwayat sesi chat)${C_RESET}"
          fi
        done
        echo ""
      fi
      ;;

    resume|continue)
      local session_id="${1:-}"
      apply_anti_ban_shield
      if [ -z "$session_id" ]; then
        echo -e "${C_GREEN}🚀 Melanjutkan sesi Freebuff percakapan sebelumnya...${C_RESET}"
        export NODE_NO_WARNINGS=1
        exec freebuff --continue
      else
        echo -e "${C_GREEN}🚀 Melanjutkan sesi Freebuff [ID: $session_id]...${C_RESET}"
        export NODE_NO_WARNINGS=1
        exec freebuff --continue "$session_id"
      fi
      ;;
  esac
}

function run_doctor() {
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_YELLOW}${C_BOLD}🩺 [FREEBUFF-POWER DOCTOR] Pemeriksaan Kesehatan Sistem${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  
  if which freebuff >/dev/null 2>&1; then
    echo -e "${C_GREEN}  [✓] Binary Freebuff CLI      : Terpasang ($(which freebuff))${C_RESET}"
  else
    echo -e "${C_RED}  [✗] Binary Freebuff CLI      : TIDAK DITEMUKAN${C_RESET}"
  fi

  if [ -d "$TEMPLATE_DIR/agents" ] && [ -d "$TEMPLATE_DIR/skills" ]; then
    local ac sc
    ac=$(ls -1 "$TEMPLATE_DIR/agents" | wc -l)
    sc=$(ls -1 "$TEMPLATE_DIR/skills" | wc -l)
    echo -e "${C_GREEN}  [✓] Template Library Superpower: Siap ($ac Agents, $sc Skills)${C_RESET}"
  else
    echo -e "${C_RED}  [✗] Template Library Superpower: Direktori Rusak / Hilang${C_RESET}"
  fi

  if [ -f "$ANALYTICS_FILE" ]; then
    echo -e "${C_GREEN}  [✓] Telemetry Configuration  : Bersih & Terisolasi${C_RESET}"
  fi

  if [ -f "AGENTS.md" ] && [ -d ".freebuff" ]; then
    echo -e "${C_GREEN}  [✓] Folder Aktif ($(pwd)) : Telah Terinjeksi Superpower${C_RESET}"
  else
    echo -e "${C_YELLOW}  [!] Folder Aktif ($(pwd)) : Belum Terinjeksi (Gunakan 'freebuff-power init')${C_RESET}"
  fi

  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_GREEN}${C_BOLD}🎉 Status Keseluruhan: SEHAT & SIAP TEMPUR!${C_RESET}\n"
}

function show_info() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo -e "${C_RED}⚠️ Harap masukkan nama agent atau skill: freebuff-power info <nama>${C_RESET}"
    exit 1
  fi
  
  target="${target#@}"
  
  local found_agent
  found_agent=$(find "$TEMPLATE_DIR/agents" -iname "*${target}*.md" | head -n 1)
  if [ -n "$found_agent" ]; then
    echo -e "${C_CYAN}👥 ================= [ Sub-Agent: @$(basename "$found_agent" .md) ] =================${C_RESET}"
    cat "$found_agent"
    echo ""
    return 0
  fi

  local found_skill
  found_skill=$(find "$TEMPLATE_DIR/skills" -iname "*${target}*.md" | head -n 1)
  if [ -n "$found_skill" ]; then
    echo -e "${C_PURPLE}🧰 ================= [ Modular Skill: $(basename "$found_skill" .md) ] =================${C_RESET}"
    cat "$found_skill"
    echo ""
    return 0
  fi

  echo -e "${C_RED}❌ Tidak ditemukan Agent atau Skill dengan nama: '$target'${C_RESET}"
}

function search_catalog() {
  local query="${1:-}"
  if [ -z "$query" ]; then
    echo -e "${C_RED}⚠️ Harap masukkan keyword: freebuff-power search <keyword>${C_RESET}"
    exit 1
  fi
  echo -e "${C_CYAN}🔍 Mencari Agents & Skills dengan keyword: '${C_BOLD}$query${C_RESET}${C_CYAN}'...${C_RESET}\n"
  
  echo -e "${C_YELLOW}--- 👥 Sub-Agents Matching: ---${C_RESET}"
  find "$TEMPLATE_DIR/agents" -iname "*$query*.md" -exec basename {} .md \; | sed 's/^/  @/' || true
  
  echo -e "\n${C_PURPLE}--- 🧰 Modular Skills Matching: ---${C_RESET}"
  find "$TEMPLATE_DIR/skills" -iname "*$query*.md" -exec basename {} .md \; | sed 's/^/  [Skill: /; s/$/]/' || true
  echo ""
}

function list_catalog() {
  local agent_count
  local skill_count
  agent_count=$(ls -1 "$TEMPLATE_DIR/agents" 2>/dev/null | wc -l || echo "0")
  skill_count=$(ls -1 "$TEMPLATE_DIR/skills" 2>/dev/null | wc -l || echo "0")
  
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_YELLOW}${C_BOLD}⚡ TOTAL ARMADA: $agent_count SUB-AGENTS & $skill_count MODULAR SKILLS${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}\n"
  
  echo -e "${C_GREEN}${C_BOLD}👥 $agent_count Sub-Agents Available:${C_RESET}"
  for f in "$TEMPLATE_DIR/agents"/*.md; do
    echo -e "  - ${C_BOLD}@$(basename "$f" .md)${C_RESET}"
  done
  echo ""
  echo -e "${C_PURPLE}${C_BOLD}🧰 $skill_count Modular Skills Terkategori (Bebas Duplikat)${C_RESET}"
}

CMD="${1:-help}"

case "$CMD" in
  start|go|full)
    shift || true
    one_shot_start "$@"
    ;;
  init)
    shift || true
    inject_superpower "${1:-$(pwd)}"
    echo -e "${C_GREEN}✅ Sukses! 38 Sub-Agents & 1,025 Modular Skills berhasil disuntikkan ke $(pwd).${C_RESET}"
    ;;
  spawn)
    shift || true
    spawn_agent "$@"
    ;;
  compose)
    shift || true
    compose_prompt "$@"
    ;;
  update)
    update_library
    ;;
  session)
    shift || true
    manage_sessions "$@"
    ;;
  continue|resume)
    shift || true
    manage_sessions "continue" "$@"
    ;;
  clean)
    apply_anti_ban_shield
    echo -e "${C_GREEN}✅ Telemetry Anonymous ID & residual cache berhasil dibersihkan (Anti-Ban Active).${C_RESET}"
    ;;
  doctor)
    run_doctor
    ;;
  info)
    shift || true
    show_info "$@"
    ;;
  search)
    shift || true
    search_catalog "$@"
    ;;
  list)
    list_catalog
    ;;
  run)
    shift || true
    apply_anti_ban_shield
    exec freebuff "$@"
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    echo -e "${C_RED}Unknown command: $CMD${C_RESET}"
    show_help
    exit 1
    ;;
esac
