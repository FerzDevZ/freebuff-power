#!/usr/bin/env bash
# ==============================================================================
# ⚡ FREEBUFF-POWER — SUPREME MULTI-AGENT, SKILLS & ANTI-BAN CLI CONTROLLER
# ==============================================================================
# Author: Freebuff Superpower Open-Source Community
# Version: 3.6.0-Enterprise
# License: MIT
# ==============================================================================
set -euo pipefail

# Determine script root directory for self-contained execution
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# Priority for template directory:
# 1. Bundled repo directory (`superpower/`)
# 2. User home directory (`~/.freebuff-superpower/`)
if [ -d "$REPO_ROOT/superpower/agents" ]; then
  TEMPLATE_DIR="$REPO_ROOT/superpower"
else
  TEMPLATE_DIR="$HOME/.freebuff-superpower"
fi

MANICODE_DIR="$HOME/.config/manicode"
ANALYTICS_FILE="$MANICODE_DIR/analytics-id.json"
OWNER_FILE="$MANICODE_DIR/freebuff-instance-owner.json"
HISTORY_FILE="$MANICODE_DIR/message-history.json"
PROJECTS_DIR="$MANICODE_DIR/projects"

# ANSI Colors
C_CYAN='\033[0;36m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_RED='\033[0;31m'
C_PURPLE='\033[0;35m'
C_BLUE='\033[0;34m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_RESET='\033[0m'

function show_help() {
  cat << 'HELP_EOF'
========================================================================================
⚡ FREEBUFF-POWER — Supreme Multi-Agent, Skills & Anti-Ban Controller (v3.6)
========================================================================================

DESKRIPSI:
  Tools manajemen open-source untuk menyuntikkan 29 Sub-Agents & 363 Modular Skills
  ke dalam sesi Freebuff, dilengkapi perisai Anti-Ban, session/chat switcher,
  dan otomatisasi workflow engineering end-to-end.

PENGGUNAAN:
  freebuff-power <command> [arguments] [options]

🔥 PERINTAH UTAMA:
  start / go / full     [SANGAT DIREKOMENDASIKAN] One-Shot All-in-One:
                        Reset Telemetry (Anti-Ban) + Injeksi 29 Agents & 363 Skills
                        + Langsung buka sesi interaktif Freebuff siap koding!

  spawn <agent> [task]  Luncurkan Freebuff langsung dengan fokus persona sub-agent
                        (Contoh: freebuff-power spawn architect "Rancang API warkop")

  init [dir]            Injeksi file AGENTS.md dan katalog .freebuff/ ke folder aktif
                        atau direktori target tanpa membuka Freebuff.

  run [args]            Jalankan sesi Freebuff biasa dengan proteksi Anti-Ban aktif.

💬 MANAJEMEN SESI & CHAT:
  continue / resume     Lanjutkan sesi percakapan/coding terakhir tanpa kehilangan konteks.
  session list          Tampilkan daftar histori sesi dan project chat sebelumnya.
  session resume <id>   Lanjutkan sesi percakapan tertentu berdasarkan ID sesi.

🛡️ PERINTAH ANTI-BAN & PEMELIHARAAN:
  clean                 Reset total anonymous UUID telemetry, hapus residual lockfile,
                        dan buat profil identitas virtual baru (100% Anti-Ban safe).

  doctor                Pemeriksaan kesehatan sistem (integritas template, telemetry,
                        permissions, dan kesiapan direktori).

🔍 PERINTAH EKSPLORASI & DISCOVERY:
  search <keyword>      Cari Sub-Agent atau Modular Skills berdasarkan kata kunci
                        (Contoh: freebuff-power search postgres)

  info <name>           Buka dan baca dokumentasi lengkap / SOP dari Agent atau Skill
                        (Contoh: freebuff-power info hallmark)

  list                  Tampilkan rekapitulasi seluruh 29 Sub-Agents & 8 Kategori Skills.

  help / --help / -h    Tampilkan panduan bantuan ini.

----------------------------------------------------------------------------------------
💡 CONTOH PENGGUNAAN NYATA:
  $ freebuff-power start                             # Mulai koding instan di folder aktif
  $ freebuff-power spawn frontend "Buat UI warkop"   # Spawn spesifik frontend agent
  $ freebuff-power continue                          # Lanjutkan sesi coding sebelumnya
  $ freebuff-power search hallmark                   # Cari skill anti-slop
  $ freebuff-power info clean-architecture           # Baca SOP Clean Architecture
========================================================================================
HELP_EOF
}

# ==============================================================================
# 🛡️ ANTI-BAN & ANTI-SUSPEND SHIELD
# ==============================================================================
function apply_anti_ban_shield() {
  mkdir -p "$MANICODE_DIR"
  local new_uuid
  new_uuid="anon_$(cat /proc/sys/kernel/random/uuid 2>/dev/null || python3 -c 'import uuid; print(uuid.uuid4())')"
  echo "{\"anonymousId\": \"$new_uuid\"}" > "$ANALYTICS_FILE"
  
  if [ -f "$OWNER_FILE" ]; then
    rm -f "$OWNER_FILE"
  fi
  
  rm -f "$MANICODE_DIR"/*.lock "$MANICODE_DIR"/*.sock "$MANICODE_DIR"/session-state.json 2>/dev/null || true
  chmod 600 "$ANALYTICS_FILE" 2>/dev/null || true
}

# ==============================================================================
# 🚀 INJECTION & WORKSPACE SYNC
# ==============================================================================
function inject_superpower() {
  local target_dir="${1:-$(pwd)}"
  
  if [ ! -d "$TEMPLATE_DIR" ]; then
    echo -e "${C_RED}❌ Error: Template library $TEMPLATE_DIR tidak ditemukan!${C_RESET}"
    exit 1
  fi

  cp -f "$TEMPLATE_DIR/AGENTS.md" "$target_dir/AGENTS.md"
  mkdir -p "$target_dir/.freebuff/agents" "$target_dir/.freebuff/skills"
  cp -rf "$TEMPLATE_DIR/agents/"* "$target_dir/.freebuff/agents/"
  cp -rf "$TEMPLATE_DIR/skills/"* "$target_dir/.freebuff/skills/"
}

# ==============================================================================
# 💬 SESSION & CHAT MANAGER
# ==============================================================================
function manage_sessions() {
  local subcmd="${1:-list}"
  shift || true

  case "$subcmd" in
    list)
      echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
      echo -e "${C_YELLOW}${C_BOLD}📋 [FREEBUFF-POWER] DAFTAR SESI & RIWAYAT CHAT PROYEK${C_RESET}"
      echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}\n"
      
      if [ -d "$PROJECTS_DIR" ]; then
        echo -e "${C_GREEN}${C_BOLD}📁 Proyek yang Tersedia:${C_RESET}"
        for p in "$PROJECTS_DIR"/*; do
          if [ -d "$p" ]; then
            local pname
            pname="$(basename "$p")"
            local chat_count
            chat_count=$(find "$p/chats" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l || echo "0")
            echo -e "  - ${C_BOLD}$pname${C_RESET} ${C_DIM}($chat_count riwayat sesi chat)${C_RESET}"
          fi
        done
        echo ""
      else
        echo -e "${C_DIM}Belum ada riwayat proyek.${C_RESET}\n"
      fi

      echo -e "${C_CYAN}👉 Untuk melanjutkan sesi terakhir: ${C_BOLD}freebuff-power continue${C_RESET}"
      echo -e "${C_CYAN}👉 Untuk melanjutkan ID sesi tertentu: ${C_BOLD}freebuff-power session resume <id>${C_RESET}\n"
      ;;

    resume|continue)
      local session_id="${1:-}"
      apply_anti_ban_shield
      if [ -z "$session_id" ]; then
        echo -e "${C_GREEN}🚀 Melanjutkan sesi Freebuff percakapan sebelumnya...${C_RESET}"
        export NODE_NO_WARNINGS=1
        exec freebuff --continue
      else
        echo -e "${C_GREEN}🚀 Melanjutkan sesi Freebuff [ID: $session_id]...${C_RESET}"
        export NODE_NO_WARNINGS=1
        exec freebuff --continue "$session_id"
      fi
      ;;

    *)
      echo -e "${C_RED}Perintah session tidak dikenal: $subcmd${C_RESET}"
      echo -e "Pilihan: freebuff-power session list | freebuff-power session resume [id]"
      exit 1
      ;;
  esac
}

# ==============================================================================
# 🎮 EXECUTION CONTROLLERS
# ==============================================================================
function one_shot_start() {
  local target_dir="$(pwd)"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_YELLOW}${C_BOLD}⚡ [FREEBUFF-POWER] ONE-SHOT ALL-IN-ONE ACTIVATION...${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  
  apply_anti_ban_shield
  echo -e "${C_GREEN}🛡️  1. Anti-Ban Telemetry Shield : ${C_BOLD}ACTIVE (Fresh Identity)${C_RESET}"
  
  inject_superpower "$target_dir"
  local a_cnt s_cnt
  a_cnt=$(ls -1 "$target_dir/.freebuff/agents" | wc -l)
  s_cnt=$(ls -1 "$target_dir/.freebuff/skills" | wc -l)
  echo -e "${C_GREEN}👥 2. Injeksi Superpower Suite   : ${C_BOLD}$a_cnt Sub-Agents & $s_cnt Skills${C_RESET}"
  echo -e "${C_BLUE}🚀 3. Membuka Sesi Interaktif Freebuff...${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}\n"
  
  export NODE_NO_WARNINGS=1
  exec freebuff "$@"
}

function spawn_agent() {
  local agent="${1:-}"
  shift || true
  local task="$*"
  
  if [ -z "$agent" ]; then
    echo -e "${C_RED}⚠️ Harap sebutkan nama agent! Contoh: freebuff-power spawn architect 'rancang sistem'${C_RESET}"
    echo -e "👉 Jalankan ${C_CYAN}freebuff-power list${C_RESET} untuk melihat daftar agent."
    exit 1
  fi

  agent="${agent#@}"
  local agent_file="$TEMPLATE_DIR/agents/${agent}.md"
  
  if [ ! -f "$agent_file" ]; then
    local matched
    matched=$(find "$TEMPLATE_DIR/agents" -iname "*${agent}*.md" | head -n 1)
    if [ -n "$matched" ]; then
      agent_file="$matched"
      agent=$(basename "$agent_file" .md)
    else
      echo -e "${C_RED}❌ Agent '@$agent' tidak ditemukan.${C_RESET}"
      exit 1
    fi
  fi

  apply_anti_ban_shield
  inject_superpower "$(pwd)"

  echo -e "${C_YELLOW}⚡ [Freebuff-Power] Spawn Sub-Agent: ${C_BOLD}@$agent${C_RESET}"
  if [ -n "$task" ]; then
    echo -e "${C_CYAN}💡 Target Task : $task${C_RESET}"
  fi
  echo -e "${C_GREEN}🚀 Meluncurkan sesi Freebuff...${C_RESET}\n"
  
  export NODE_NO_WARNINGS=1
  exec freebuff
}

function run_doctor() {
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_YELLOW}${C_BOLD}🩺 [FREEBUFF-POWER DOCTOR] Pemeriksaan Kesehatan Sistem${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  
  if which freebuff >/dev/null 2>&1; then
    echo -e "${C_GREEN}  [✓] Binary Freebuff CLI      : Terpasang ($(which freebuff))${C_RESET}"
  else
    echo -e "${C_RED}  [✗] Binary Freebuff CLI      : TIDAK DITEMUKAN${C_RESET}"
  fi

  if [ -d "$TEMPLATE_DIR/agents" ] && [ -d "$TEMPLATE_DIR/skills" ]; then
    local ac sc
    ac=$(ls -1 "$TEMPLATE_DIR/agents" | wc -l)
    sc=$(ls -1 "$TEMPLATE_DIR/skills" | wc -l)
    echo -e "${C_GREEN}  [✓] Template Library Superpower: Siap ($ac Agents, $sc Skills)${C_RESET}"
  else
    echo -e "${C_RED}  [✗] Template Library Superpower: Direktori Rusak / Hilang${C_RESET}"
  fi

  if [ -f "$ANALYTICS_FILE" ]; then
    echo -e "${C_GREEN}  [✓] Telemetry Configuration  : Bersih & Terisolasi${C_RESET}"
  else
    echo -e "${C_YELLOW}  [!] Telemetry Configuration  : Belum diinisialisasi (Jalankan 'freebuff-power clean')${C_RESET}"
  fi

  if [ -f "AGENTS.md" ] && [ -d ".freebuff" ]; then
    echo -e "${C_GREEN}  [✓] Folder Aktif ($(pwd)) : Telah Terinjeksi Superpower${C_RESET}"
  else
    echo -e "${C_YELLOW}  [!] Folder Aktif ($(pwd)) : Belum Terinjeksi (Gunakan 'freebuff-power init')${C_RESET}"
  fi

  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_GREEN}${C_BOLD}🎉 Status Keseluruhan: SEHAT & SIAP TEMPUR!${C_RESET}\n"
}

function show_info() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo -e "${C_RED}⚠️ Harap masukkan nama agent atau skill: freebuff-power info <nama>${C_RESET}"
    exit 1
  fi
  
  target="${target#@}"
  
  local found_agent
  found_agent=$(find "$TEMPLATE_DIR/agents" -iname "*${target}*.md" | head -n 1)
  if [ -n "$found_agent" ]; then
    echo -e "${C_CYAN}👥 ================= [ Sub-Agent: @$(basename "$found_agent" .md) ] =================${C_RESET}"
    cat "$found_agent"
    echo ""
    return 0
  fi

  local found_skill
  found_skill=$(find "$TEMPLATE_DIR/skills" -iname "*${target}*.md" | head -n 1)
  if [ -n "$found_skill" ]; then
    echo -e "${C_PURPLE}🧰 ================= [ Modular Skill: $(basename "$found_skill" .md) ] =================${C_RESET}"
    cat "$found_skill"
    echo ""
    return 0
  fi

  echo -e "${C_RED}❌ Tidak ditemukan Agent atau Skill dengan nama: '$target'${C_RESET}"
  echo -e "👉 Gunakan: ${C_CYAN}freebuff-power search $target${C_RESET}"
}

function search_catalog() {
  local query="${1:-}"
  if [ -z "$query" ]; then
    echo -e "${C_RED}⚠️ Harap masukkan keyword: freebuff-power search <keyword>${C_RESET}"
    exit 1
  fi
  echo -e "${C_CYAN}🔍 Mencari Agents & Skills dengan keyword: '${C_BOLD}$query${C_RESET}${C_CYAN}'...${C_RESET}\n"
  
  echo -e "${C_YELLOW}--- 👥 Sub-Agents Matching: ---${C_RESET}"
  find "$TEMPLATE_DIR/agents" -iname "*$query*.md" -exec basename {} .md \; | sed 's/^/  @/' || true
  
  echo -e "\n${C_PURPLE}--- 🧰 Modular Skills Matching: ---${C_RESET}"
  find "$TEMPLATE_DIR/skills" -iname "*$query*.md" -exec basename {} .md \; | sed 's/^/  [Skill: /; s/$/]/' || true
  echo ""
}

function list_catalog() {
  local agent_count
  local skill_count
  agent_count=$(ls -1 "$TEMPLATE_DIR/agents" 2>/dev/null | wc -l || echo "0")
  skill_count=$(ls -1 "$TEMPLATE_DIR/skills" 2>/dev/null | wc -l || echo "0")
  
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}"
  echo -e "${C_YELLOW}${C_BOLD}⚡ TOTAL ARMADA: $agent_count SUB-AGENTS & $skill_count MODULAR SKILLS${C_RESET}"
  echo -e "${C_CYAN}${C_BOLD}========================================================================${C_RESET}\n"
  
  echo -e "${C_GREEN}${C_BOLD}👥 29 Sub-Agents Available:${C_RESET}"
  for f in "$TEMPLATE_DIR/agents"/*.md; do
    echo -e "  - ${C_BOLD}@$(basename "$f" .md)${C_RESET}"
  done
  echo ""
  echo -e "${C_PURPLE}${C_BOLD}🧰 363 Modular Skills Terkategori (Bebas Duplikat):${C_RESET}"
  echo "  1. Architecture & Design (Clean Architecture, CQRS, DDD, REST/gRPC/GraphQL, Event Sourcing)"
  echo "  2. Backend Polyglot (FastAPI, NestJS, Go Concurrency, Rust Tokio, Spring Boot, Deno/Bun)"
  echo "  3. Frontend & Mobile (Next.js 15, React 19, Vue/Nuxt, Tailwind, SwiftUI, Jetpack Compose, Flutter)"
  echo "  4. Database & OLAP (Postgres Internals, ClickHouse, DuckDB, Redis Streams, MongoDB, SQLite Edge)"
  echo "  5. Quality & QA (Vitest TDD, Playwright E2E, k6 Load Testing, Mutation Testing, Pact)"
  echo "  6. Security & AppSec (OWASP Top 10, Authflow PKCE, Passkeys, Prompt Injection Shield, SBOM)"
  echo "  7. AI & Agentics (RAG Pipelines, pgvector/Qdrant, LLM Evals, vLLM/Ollama, AI Observability)"
  echo "  8. Anti-Slop & Performance (Anti-Waffle, Cognitive Load Minimizer, Core Web Vitals, Heap Profiler)"
  echo -e "\n${C_DIM}👉 Gunakan 'freebuff-power search <keyword>' untuk menemukan skill spesifik.${C_RESET}\n"
}

# Entrypoint
CMD="${1:-help}"

case "$CMD" in
  start|go|full)
    shift || true
    one_shot_start "$@"
    ;;
  init)
    shift || true
    inject_superpower "${1:-$(pwd)}"
    echo -e "${C_GREEN}✅ Sukses! 29 Sub-Agents & 363 Modular Skills berhasil disuntikkan ke $(pwd).${C_RESET}"
    ;;
  spawn)
    shift || true
    spawn_agent "$@"
    ;;
  session)
    shift || true
    manage_sessions "$@"
    ;;
  continue|resume)
    shift || true
    manage_sessions "continue" "$@"
    ;;
  clean)
    apply_anti_ban_shield
    echo -e "${C_GREEN}✅ Telemetry Anonymous ID & residual cache berhasil dibersihkan (Anti-Ban Active).${C_RESET}"
    ;;
  doctor)
    run_doctor
    ;;
  info)
    shift || true
    show_info "$@"
    ;;
  search)
    shift || true
    search_catalog "$@"
    ;;
  list)
    list_catalog
    ;;
  run)
    shift || true
    apply_anti_ban_shield
    exec freebuff "$@"
    ;;
  help|-h|--help)
    show_help
    ;;
  *)
    echo -e "${C_RED}Unknown command: $CMD${C_RESET}"
    show_help
    exit 1
    ;;
esac
